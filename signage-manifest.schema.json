{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "signage-manifest.schema.json",
  "title": "Roku signage manifest (version 1)",
  "description": "Schedule and media list fetched by the Roku signage channel. Times are local to the TV; any time-zone suffix is ignored.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "maxLength": 120 },
    "settings": { "$ref": "#/definitions/settings" },
    "defaultPlaylist": { "type": "string", "description": "Playlist used when no schedule rule matches. Defaults to \"main\"." },
    "items": {
      "description": "Short form: a single playlist named \"main\" (use instead of \"playlists\").",
      "type": "array",
      "items": { "$ref": "#/definitions/item" }
    },
    "playlists": {
      "type": "object",
      "maxProperties": 50,
      "description": "Named playlists. An empty array shows a black screen.",
      "additionalProperties": { "type": "array", "items": { "$ref": "#/definitions/item" } }
    },
    "schedule": {
      "type": "array",
      "maxItems": 100,
      "description": "Rules that pick a playlist. The highest priority match wins; ties go to the earlier rule.",
      "items": { "$ref": "#/definitions/rule" }
    },
    "override": {
      "type": "object",
      "description": "Takes over every screen immediately until \"until\". Remove it (or set enabled: false) to end early.",
      "required": ["playlist", "until"],
      "properties": {
        "playlist": { "type": "string" },
        "from": { "$ref": "#/definitions/localDateTime" },
        "until": { "$ref": "#/definitions/localDateTime" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "description": "Change a value to trigger the action once on every screen.",
      "properties": {
        "restart": { "type": ["string", "integer"], "description": "Restart the playlist from its first item." },
        "purgeCache": { "type": ["string", "integer"], "description": "Delete cached media and download it again." }
      },
      "additionalProperties": false
    }
  },
  "anyOf": [{ "required": ["playlists"] }, { "required": ["items"] }],
  "additionalProperties": false,
  "definitions": {
    "clock": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$|^24:00$", "description": "24-hour HH:MM in TV-local time." },
    "localDateTime": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?([Zz]|[+-]\\d{2}:?\\d{2})?)?$",
      "description": "YYYY-MM-DD or YYYY-MM-DDTHH:MM (TV-local). A date-only \"until\" includes that whole day."
    },
    "day": {
      "type": "string",
      "enum": ["sun", "mon", "tue", "wed", "thu", "fri", "sat", "sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "tues", "thur", "thurs", "weekdays", "weekends", "daily", "all"]
    },
    "when": {
      "type": "object",
      "properties": {
        "days": {
          "oneOf": [
            { "$ref": "#/definitions/day" },
            { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/definitions/day" }, { "type": "integer", "minimum": 0, "maximum": 6 }] } }
          ]
        },
        "start": { "$ref": "#/definitions/clock" },
        "end": { "$ref": "#/definitions/clock" },
        "from": { "$ref": "#/definitions/localDateTime" },
        "until": { "$ref": "#/definitions/localDateTime" }
      },
      "additionalProperties": false
    },
    "fit": { "type": "string", "enum": ["fit", "fill", "stretch"] },
    "item": {
      "oneOf": [
        { "type": "string", "description": "Shorthand: just the URL of an image or video." },
        {
          "type": "object",
          "required": ["url"],
          "properties": {
            "id": { "type": ["string", "integer"], "description": "Stable id; keeps playback position across edits." },
            "type": { "type": "string", "enum": ["image", "video"], "description": "Inferred from the file extension when omitted." },
            "url": { "type": "string", "minLength": 1, "description": "https:// URL, or a path relative to this manifest." },
            "seconds": { "type": "integer", "minimum": 0, "maximum": 7200, "description": "Image: display time (2-3600). Video: optional cap; 0 plays to the end." },
            "rev": { "type": ["string", "integer"], "description": "Bump after replacing a file at the same URL to force a re-download." },
            "muted": { "type": "boolean" },
            "fit": { "$ref": "#/definitions/fit" },
            "title": { "type": "string" },
            "enabled": { "type": "boolean" },
            "when": { "$ref": "#/definitions/when" }
          },
          "additionalProperties": false
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["playlist"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "playlist": { "type": "string" },
        "priority": { "type": "integer" },
        "interrupt": { "type": "boolean", "description": "Switch the moment the rule starts instead of after the current item." },
        "when": { "$ref": "#/definitions/when" }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "pollSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "imageSeconds": { "type": "integer", "minimum": 2, "maximum": 3600 },
        "transition": { "type": "string", "enum": ["fade", "cut"] },
        "transitionMs": { "type": "integer", "minimum": 0, "maximum": 3000 },
        "fit": { "$ref": "#/definitions/fit" },
        "muteVideo": { "type": "boolean" },
        "showStatus": { "type": "boolean", "description": "Keep the diagnostics panel on screen." },
        "heartbeatUrl": { "type": "string", "pattern": "^https://", "description": "Optional endpoint that receives a JSON status POST." },
        "heartbeatMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "cacheVideos": { "type": "string", "enum": ["auto", "always", "never"] }
      },
      "additionalProperties": false
    }
  }
}
